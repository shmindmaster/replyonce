{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "replyonce": ["./src/index.ts"],
      "replyonce/adapters": ["./src/adapters/index.ts"],
      "replyonce/postgres": ["./src/stores/postgres.ts"],
      "replyonce/redis": ["./src/stores/redis.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts"]
}
